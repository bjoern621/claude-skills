{
  "name": "bjoern",
  "description": "Personal conventions: style for comments, docs, commit bodies, pull requests and interface text, plus merge request review rounds.",
  "author": {
    "name": "Björn",
    "url": "https://github.com/bjoern621"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/writing-style-reminder.sh UserPromptSubmit prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/writing-style-reminder.sh PreToolUse source",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
